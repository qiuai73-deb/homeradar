        {
          "title": "金麒麟金牌董秘揭晓",
          "url": "https://finance.sina.com.cn/zt_d/subject-1785723876",
          "published": "2026-08-12",
          "summary": "金麒麟金牌董秘揭晓",
          "source": "新浪"
