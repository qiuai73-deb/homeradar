        {
          "title": "涨得多，跌得浅，修复稳：好股的特征",
          "url": "http://xueqiu.com/5672579962/404231260",
          "published": "Sat, 08 Aug 2026 14:54:36 GMT",
          "summary": "",
          "source": "雪球"
