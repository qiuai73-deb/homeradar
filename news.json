        {
          "title": "光进铜退，但是铜的价值却越来越高",
          "url": "http://xueqiu.com/8755156034/409945735",
          "published": "Sun, 20 Sep 2026 11:02:31 GMT",
          "summary": "",
          "source": "雪球"
