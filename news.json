        {
          "title": "一瓶酒，两种价格—— 茅台的溢价、终局与回报",
          "url": "http://xueqiu.com/1835829265/411134956",
          "published": "Fri, 02 Oct 2026 04:50:53 GMT",
          "summary": "",
          "source": "雪球"
